# Shared password to unlock the app (choose your own strong password)
APP_PASSWORD=

# Long random string used to sign the login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Your OpenRouter API key (get one at https://openrouter.ai/keys)
# Never commit this file with a real value, and never paste your real key into chat.
OPENROUTER_API_KEY=

# Optional: override the default model used for analysis + chat
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Postgres connection string. When you add Vercel Postgres (or Neon) to your
# Vercel project, this (and related POSTGRES_* vars) are set for you automatically.
POSTGRES_URL=
